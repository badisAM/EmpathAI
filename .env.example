# Free Groq keys (no credit card): https://console.groq.com
# One or several, comma-separated; they rotate automatically on rate limits.
GROQ_API_KEYS=gsk_your_first_key,gsk_your_second_key
GROQ_MODEL=llama-3.3-70b-versatile

# Storage + knowledge
DB_PATH=empathai.db
KNOWLEDGE_DIR=knowledge

# Optional facial modality (needs requirements-face.txt)
ENABLE_FACE=0

# RAG backend: tfidf (default) or fastembed (needs requirements-embeddings.txt)
RAG_BACKEND=tfidf
